name: Generate Snake Animation

on:
  schedule:
    # Runs daily at midnight UTC
    - cron: "0 0 * * *"
  workflow_dispatch:

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    permissions:
      contents: write

    steps:
      - name: Generate Snake — Dark Mode
        uses: Platane/snk/svg-only@v3
        with:
          github_user_name: krishgf
          outputs: |
            dist/github-snake-dark.svg?palette=github-dark&color_snake=ff6b9d&color_dots=#0d0015,#2d1b3d,#6b3fa0,#c084fc,#ff6b9d

      - name: Generate Snake — Light Mode
        uses: Platane/snk/svg-only@v3
        with:
          github_user_name: krishgf
          outputs: |
            dist/github-snake.svg?palette=github-light&color_snake=d6336c&color_dots=#ebedf0,#f3e8ff,#d8b4fe,#a855f7,#d6336c

      - name: Push to output branch
        uses: crazy-max/ghaction-github-pages@v4
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
